---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(currentIndex + 1) % projects.length];

const chapters = [
  { id: "problem", label: "The Problem" },
  { id: "role", label: "The Role" },
  { id: "design", label: "The Design" },
  { id: "build", label: "The Build" },
  { id: "hard-part", label: "The Hard Part" },
  { id: "outcome", label: "The Outcome" },
  { id: "details", label: "The Details" },
];
---
<Layout title={project.name} description={project.summary} image={project.heroImage}>
  <Header slot="header" />

  <article class="case" style={`--accent-a:${project.accent.a}; --accent-b:${project.accent.b};`}>
    <header class="case__hero">
      <div class="container">
        <a class="back-link" href="/#work">← All work</a>
        <p class="eyebrow case__kind" data-reveal>{project.kind} · {project.years} · {project.status}</p>
        <h1 data-reveal data-reveal-delay="60">{project.name}</h1>
        <p class="case__tagline" data-reveal data-reveal-delay="120">{project.tagline}</p>
        <p class="case__role" data-reveal data-reveal-delay="160">{project.role}</p>
        <div class="case__links" data-reveal data-reveal-delay="200">
          {project.live && <a class="btn btn--ghost" href={project.live} target="_blank" rel="noopener noreferrer">Live site ↗</a>}
          {project.appStore && <a class="btn btn--ghost" href={project.appStore} target="_blank" rel="noopener noreferrer">App Store ↗</a>}
        </div>
      </div>
    </header>

    <div class="case__image-wrap container" data-reveal>
      <img src={project.heroImage} alt={project.images[0]?.alt || project.name} class="case__image" />
      {project.note && <p class="case__note">{project.note}</p>}
    </div>

    <div class="container case__layout">
      <nav class="case__rail" data-chapter-rail aria-label={`${project.name} case study chapters`}>
        <ol>
          {chapters.map((c) => <li><a href={`#${c.id}`}>{c.label}</a></li>)}
        </ol>
      </nav>

      <div class="case__body">
        <section id="problem" data-chapter class="case__section">
          <h2>The Problem</h2>
          <p>{project.whyItExisted}</p>
        </section>

        <section id="role" data-chapter class="case__section">
          <h2>The Role</h2>
          <p>{project.role_detail}</p>
          <p class="case__whatitis">{project.whatItIs}</p>
        </section>

        <section id="design" data-chapter class="case__section">
          <h2>The Design</h2>
          <ul>{project.designed.map((d) => <li>{d}</li>)}</ul>
        </section>

        <section id="build" data-chapter class="case__section">
          <h2>The Build</h2>
          <ul>{project.built.map((b) => <li>{b}</li>)}</ul>
        </section>

        <section id="hard-part" data-chapter class="case__section">
          <h2>The Hard Part</h2>
          <ul>{project.challenges.map((c) => <li>{c}</li>)}</ul>
        </section>

        <section id="outcome" data-chapter class="case__section case__outcome">
          <h2>The Outcome</h2>
          <p>{project.outcome}</p>
        </section>

        {project.images.length > 1 && (
          <section class="case__gallery">
            {project.images.slice(1).map((img) => (
              <img src={img.src} alt={img.alt} loading="lazy" />
            ))}
          </section>
        )}

        <section id="details" data-chapter class="case__section">
          <h2>The Details</h2>
          <p class="case__tech">{project.tech.join(" · ")}</p>
        </section>
      </div>
    </div>

    <a class="case__next" href={`/work/${next.slug}/`} style={`--next-a:${next.accent.a}; --next-b:${next.accent.b};`}>
      <div class="container case__next-inner">
        <p class="eyebrow">Next project</p>
        <h3>{next.name}</h3>
        <p>{next.tagline}</p>
        <span class="case__next-arrow">→</span>
      </div>
    </a>
  </article>

  <Footer slot="footer" />

  <script>
    import "../../scripts/reveal.js";
    import "../../scripts/chapter-rail.js";
  </script>
</Layout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--graphite);
    margin-bottom: var(--space-3);
  }
  .case__hero { padding-block: var(--space-6) var(--space-4); }
  .case__kind { color: var(--accent-b); }
  .case__hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-5);
    line-height: 1.05;
    margin: 0.3rem 0 var(--space-2);
  }
  .case__tagline { font-size: var(--step-1); color: var(--graphite); max-width: 38rem; }
  .case__role { font-family: var(--font-mono); font-size: var(--step--1); margin-top: var(--space-2); }
  .case__links { display: flex; gap: var(--space-2); margin-top: var(--space-3); }

  .case__image-wrap { margin-bottom: var(--space-6); }
  .case__image {
    width: 100%;
    border-radius: var(--radius-md);
    border-top: 6px solid var(--accent-a);
  }
  .case__note {
    font-size: var(--step--1);
    color: var(--graphite);
    font-style: italic;
    margin-top: var(--space-2);
  }

  .case__layout {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-5);
    align-items: start;
  }
  .case__rail { position: sticky; top: 5rem; }
  .case__rail ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .case__rail a {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--graphite);
    text-decoration: none;
    padding: 0.4rem 0 0.4rem 0.9rem;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: color var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
  }
  .case__rail a.is-active { color: var(--ink); border-left-color: var(--accent-a); }

  .case__body { max-width: 44rem; }
  .case__section { margin-bottom: var(--space-5); }
  .case__section h2 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    margin: 0 0 var(--space-2);
  }
  .case__section p { color: var(--ink); }
  .case__whatitis { color: var(--graphite); }
  .case__section ul { padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .case__outcome {
    border-left: 3px solid var(--accent-a);
    padding-left: var(--space-3);
  }
  .case__tech { font-family: var(--font-mono); font-size: var(--step--1); color: var(--graphite); }

  .case__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .case__gallery img { border-radius: var(--radius-sm); }

  .case__next {
    display: block;
    text-decoration: none;
    color: var(--paper);
    background: linear-gradient(135deg, var(--next-b), color-mix(in srgb, var(--next-b) 70%, black));
    margin-top: var(--space-6);
    transition: filter var(--dur-standard) var(--ease-standard);
  }
  .case__next:hover { filter: brightness(1.08); }
  .case__next-inner { padding-block: var(--space-6); position: relative; }
  .case__next .eyebrow { color: color-mix(in srgb, var(--next-a) 80%, white); }
  .case__next h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    margin: 0.3rem 0;
  }
  .case__next p { margin: 0; opacity: 0.85; max-width: 34rem; }
  .case__next-arrow {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-4);
    font-size: var(--step-4);
    transition: transform var(--dur-standard) var(--ease-standard);
  }
  .case__next:hover .case__next-arrow { transform: translateX(6px); }

  @media (max-width: 860px) {
    .case__layout { grid-template-columns: 1fr; }
    .case__rail { position: static; overflow-x: auto; padding-bottom: 0.5rem; }
    .case__rail ol { display: flex; border-left: none; gap: 0.3rem; }
    .case__rail a {
      border-left: none;
      border-bottom: 2px solid transparent;
      padding: 0.3rem 0.6rem;
      white-space: nowrap;
    }
    .case__rail a.is-active { border-bottom-color: var(--accent-a); }
  }
</style>
