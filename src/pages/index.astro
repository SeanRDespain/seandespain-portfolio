---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectTile from "../components/ProjectTile.astro";
import { projects } from "../data/projects.js";

const capabilities = [
  { label: "Product", items: ["Product architecture", "User flows & progression systems", "Freemium/paywall design", "Booking & conversion funnels"] },
  { label: "Development", items: ["Unity (C#)", "Next.js / React / TypeScript", "Astro", "Firebase", "API integrations", "iOS & Android release"] },
  { label: "Brand & Creative", items: ["Visual identity systems", "Typography systems", "Original character/IP design", "Campaign production"] },
  { label: "Marketing", items: ["SEO", "GA4 & conversion tracking", "JSON-LD structured data", "Lead-generation funnels"] },
];
---
<Layout title="Product Builder & Creative Technologist">
  <Header slot="header" />

  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">Product · Brand · Code</p>
      <h1>
        I design, build, and launch <span class="serif-italic">digital products and brands.</span>
      </h1>
      <p class="hero__sub">
        Five ventures, founded and operated end to end — a wellness app live on the App Store, a
        business platform running four companies, a 50-person staffing company, a bilingual
        conservation program in the Amazon, and a children's entertainment brand. Same person,
        every time: concept, design, code, brand, and launch.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#work">View selected work</a>
        <a class="btn btn--ghost" href="/resume/Sean_Despain_Resume_Hybrid_ProductCreativeTech.docx">Download résumé</a>
      </div>
    </div>
  </section>

  <section id="work" class="work">
    <div class="container">
      <div class="section-head">
        <h2>Five worlds, one builder</h2>
        <p class="section-head__sub">Each of these is a real, shipped or shipping product — its colors and imagery are its own, not a template.</p>
      </div>
      <div class="work__grid">
        {projects.map((project) => <ProjectTile project={project} />)}
      </div>
    </div>
  </section>

  <section class="capabilities">
    <div class="container">
      <div class="section-head">
        <h2>What that actually means</h2>
        <p class="section-head__sub">Capability comes from the work above — nothing here is a claim without a project behind it.</p>
      </div>
      <div class="capabilities__grid">
        {capabilities.map((group) => (
          <div class="capabilities__group">
            <p class="eyebrow">{group.label}</p>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <a class="text-link" href="/capabilities/">See the full breakdown →</a>
    </div>
  </section>

  <section class="about-teaser">
    <div class="container about-teaser__inner">
      <p class="serif-italic about-teaser__quote">
        "I don't hand off any part of the pipeline. I identify the need, design the brand and the
        UX, build the working software, write the launch systems, then operate the result."
      </p>
      <a class="btn btn--ghost" href="/about/">More about how I work →</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }
  .hero__inner { max-width: 46rem; }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-5);
    line-height: 1.05;
    margin: 0.5rem 0 var(--space-3);
  }
  .hero__sub {
    color: var(--graphite);
    font-size: var(--step-1);
    max-width: 42rem;
  }
  .hero__ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--ink);
  }
  .btn--primary { background: var(--ink); color: var(--paper); }
  .btn--primary:hover { background: var(--ink-soft); }
  .btn--ghost { background: transparent; color: var(--ink); }
  .btn--ghost:hover { background: var(--line); }

  .section-head { max-width: 40rem; margin-bottom: var(--space-4); }
  .section-head h2 {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    margin: 0 0 0.4rem;
  }
  .section-head__sub { color: var(--graphite); margin: 0; }

  .work { padding-block: var(--space-6); }
  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
  }

  .capabilities {
    padding-block: var(--space-6);
    background: var(--paper-raised);
    border-block: 1px solid var(--line);
  }
  .capabilities__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .capabilities__group ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .text-link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }

  .about-teaser { padding-block: var(--space-7); }
  .about-teaser__inner { max-width: 42rem; }
  .about-teaser__quote {
    font-size: var(--step-3);
    line-height: 1.3;
    margin: 0 0 var(--space-4);
  }
</style>
