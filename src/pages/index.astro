---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/projects.js";

const capabilities = [
  { label: "Product", items: ["Product architecture", "User flows & progression systems", "Freemium/paywall design", "Booking & conversion funnels"] },
  { label: "Development", items: ["Unity (C#)", "Next.js / React / TypeScript", "Astro", "Firebase", "API integrations", "iOS & Android release"] },
  { label: "Brand & Creative", items: ["Visual identity systems", "Typography systems", "Original character/IP design", "Campaign production"] },
  { label: "Marketing", items: ["SEO", "GA4 & conversion tracking", "JSON-LD structured data", "Lead-generation funnels"] },
];

// deterministic starfield: same build, same sky, so screenshots/QA are stable
function seededRandom(seed) {
  let s = seed;
  return () => {
    s = (s * 1103515245 + 12345) & 0x7fffffff;
    return s / 0x7fffffff;
  };
}
const rand = seededRandom(1337);
const stars = Array.from({ length: 160 }).map((_, i) => {
  const big = i % 9 === 0;
  return {
    top: (rand() * 100).toFixed(1),
    left: (rand() * 100).toFixed(1),
    size: big ? (2.1 + rand() * 1.5).toFixed(2) : (1 + rand() * 0.9).toFixed(2),
    opacity: (big ? 0.8 : 0.5) + rand() * 0.4,
    twinkle: i % 3 !== 2,
    flare: big && i % 27 === 0,
    delay: (rand() * 6).toFixed(2),
    duration: (3 + rand() * 3).toFixed(2),
  };
});

// matrix-style digit columns rising from the bottom edge and dissolving
// partway up. Denser at the edges, thinned out behind the headline/body
// text column (roughly 26-72% of the width) so the effect frames the
// copy instead of fighting it. Two "depths" (front: bigger, brighter,
// sharper; back: smaller, dimmer, slightly blurred) give it read as a
// field with real space in it, not a flat wall of digits.
const COLS = 38;
const matrixCols = Array.from({ length: COLS }).map((_, i) => {
  const left = 1 + (i / (COLS - 1)) * 98 + (rand() * 2.2 - 1.1);
  const inTextZone = left > 26 && left < 72;
  const front = rand() > 0.55;
  const digitCount = front ? 12 : 8;
  const digits = Array.from({ length: digitCount })
    .map(() => (rand() > 0.5 ? "1" : "0"))
    .join("");
  return {
    left: left.toFixed(1),
    digits,
    front,
    delay: (rand() * 10).toFixed(2),
    duration: (front ? 6 + rand() * 4 : 9 + rand() * 6).toFixed(2),
    rise: (front ? 34 + rand() * 14 : 22 + rand() * 12).toFixed(0),
    peakOpacity: ((front ? 0.55 : 0.32) * (inTextZone ? 0.4 : 1)).toFixed(2),
  };
});
---
<Layout title="Product Builder & Creative Technologist">
  <Header slot="header" />

  <section class="hero">
    <div class="hero__aura" aria-hidden="true">
      <span class="hero__glow hero__glow--gold"></span>
      <span class="hero__glow hero__glow--teal"></span>
      <span class="hero__stars">
        {stars.map((s) => (
          <span
            class:list={["hero__star", s.twinkle && "hero__star--twinkle", s.flare && "hero__star--flare"]}
            style={`top:${s.top}%; left:${s.left}%; width:${s.size}px; height:${s.size}px; opacity:${s.opacity.toFixed(2)}; animation-delay:${s.delay}s; animation-duration:${s.duration}s;`}
          ></span>
        ))}
      </span>
      <span class="hero__shooting-star hero__shooting-star--1"></span>
      <span class="hero__shooting-star hero__shooting-star--2"></span>
      <span class="hero__shooting-star hero__shooting-star--3"></span>
      <span class="hero__matrix">
        {matrixCols.map((col) => (
          <span
            class:list={["hero__matrix-col", col.front ? "hero__matrix-col--front" : "hero__matrix-col--back"]}
            style={`left:${col.left}%; animation-delay:${col.delay}s; animation-duration:${col.duration}s; --rise:${col.rise}; --peak:${col.peakOpacity};`}
          >{col.digits.split("").join("\n")}</span>
        ))}
      </span>
      <span class="hero__aura-vignette"></span>
    </div>
    <div class="container hero__inner">
      <p class="eyebrow" data-reveal>Product · Brand · Code</p>
      <h1 data-reveal data-reveal-delay="60">
        I design, build, and launch <span class="serif-italic">digital products and brands.</span>
      </h1>

      <p class="hero__pipeline" data-reveal data-reveal-delay="140">
        <span class="hero__pipeline-label">Every venture, the same throughline:</span>
        <span class="hero__pipeline-word-wrap"><span data-pipeline-word>Concept</span></span>
        <noscript>&nbsp;Concept → Brand → UX → Code → Launch → Operate</noscript>
      </p>

      <p class="hero__sub" data-reveal data-reveal-delay="200">
        Five ventures, founded and operated end to end: a wellness app live on the App Store, a
        business platform running four companies, a 50-person staffing company, a bilingual
        conservation program in the Amazon, and a children's entertainment brand. Same person,
        every time.
      </p>
      <div class="hero__ctas" data-reveal data-reveal-delay="260">
        <a class="btn btn--primary" href="#work">View selected work</a>
        <a class="btn btn--ghost" href="/resume/Sean_Despain_Resume_Hybrid_ProductCreativeTech.docx">Download résumé</a>
      </div>

      <ul class="hero__stamps" data-reveal data-reveal-delay="320" aria-label="Jump to a project">
        {projects.map((p) => (
          <li>
            <a href={`#${p.slug}`} style={`--stamp:${p.accent.a}`}>
              <span class="hero__stamp-dot" aria-hidden="true"></span>{p.short}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="work" class="reel">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Five worlds, one builder</h2>
        <p class="section-head__sub">Real, shipped or shipping products. The colors and imagery below are each project's own, not a template applied five times.</p>
      </div>
    </div>

    <div class="reel__spine" role="presentation">
      {projects.map((project, i) => (
        <article
          id={project.slug}
          class="reel__row"
          class:list={[i % 2 === 1 && "reel__row--reverse"]}
          style={`--row-a:${project.accent.a}; --row-b:${project.accent.b};`}
          data-reveal
        >
          <span class="reel__node" style={`--row-a:${project.accent.a};`} aria-hidden="true"></span>
          <span class="reel__row-aura" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <div class="container reel__row-inner">
            <a href={`/work/${project.slug}/`} class="reel__media">
              <img src={project.heroImage} alt="" loading="lazy" />
            </a>
            <div class="reel__copy">
              <p class="reel__kind">{project.kind} · {project.years} · {project.status}</p>
              <h3><a href={`/work/${project.slug}/`}>{project.name}</a></h3>
              <p class="reel__tagline">{project.tagline}</p>
              <p class="reel__role">{project.role}</p>
              <p class="reel__tech">{project.tech.slice(0, 4).join(" · ")}</p>
              <a class="reel__cta" href={`/work/${project.slug}/`}>Read the case study →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="capabilities">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>What that actually means</h2>
        <p class="section-head__sub">Capability comes from the work above. Nothing here is a claim without a project behind it.</p>
      </div>
      <div class="capabilities__grid">
        {capabilities.map((group, i) => (
          <div class="capabilities__group" data-reveal data-reveal-delay={i * 60}>
            <p class="eyebrow">{group.label}</p>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <a class="text-link" href="/capabilities/">See the full capability → project matrix →</a>
    </div>
  </section>

  <section class="about-teaser">
    <div class="container about-teaser__inner" data-reveal>
      <p class="serif-italic about-teaser__quote">
        "I don't hand off any part of the pipeline. I identify the need, design the brand and the
        UX, build the working software, write the launch systems, then operate the result."
      </p>
      <a class="btn btn--ghost" href="/about/">More about how I work →</a>
    </div>
  </section>

  <Footer slot="footer" />

  <script>
    import "../scripts/reveal.js";
    import "../scripts/pipeline-cycle.js";
  </script>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(130% 100% at 22% 0%, #262b33 0%, #16181d 55%, #0d0e11 100%);
    padding-block: var(--space-7) var(--space-6);
  }
  .hero__aura {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .hero__aura-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(85% 75% at 50% 35%, transparent 45%, rgba(6, 7, 8, 0.5) 100%);
    z-index: 1;
  }
  /* two quiet, slow-drifting glows: the whole "signature moment" for the
     hero. No literal theme, no texture, just calm depth and color. */
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    mix-blend-mode: screen;
    opacity: 0.3;
    animation: glowDrift 42s var(--ease-in-out) infinite;
  }
  .hero__glow--gold {
    top: -18%;
    right: -12%;
    width: 46vw;
    height: 46vw;
    max-width: 620px;
    max-height: 620px;
    min-width: 340px;
    min-height: 340px;
    background: var(--pl-gold);
  }
  .hero__glow--teal {
    bottom: -22%;
    left: -14%;
    width: 40vw;
    height: 40vw;
    max-width: 540px;
    max-height: 540px;
    min-width: 300px;
    min-height: 300px;
    background: color-mix(in srgb, var(--pl-teal) 55%, #0d0e11 45%);
    opacity: 0.34;
    animation-duration: 50s;
    animation-delay: -18s;
  }
  @keyframes glowDrift {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: 3% 4%; scale: 1.08; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__glow { animation: none; }
  }
  .hero__stars { position: absolute; inset: 0; z-index: 1; }
  .hero__star {
    position: absolute;
    border-radius: 50%;
    background: #fdf9ee;
  }
  .hero__star--twinkle { animation: starTwinkle 4s ease-in-out infinite; }
  @keyframes starTwinkle {
    0%, 100% { opacity: var(--star-o, 0.5); scale: 1; }
    50% { opacity: 0.15; scale: 0.7; }
  }
  /* a handful of the brightest stars get a four-point glint, the way real
     bright stars flare through a camera lens. Rare on purpose. */
  .hero__star--flare::before,
  .hero__star--flare::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: linear-gradient(90deg, transparent, rgba(253, 249, 238, 0.75), transparent);
    translate: -50% -50%;
  }
  .hero__star--flare::before { width: 24px; height: 1px; }
  .hero__star--flare::after {
    width: 1px;
    height: 24px;
    background: linear-gradient(180deg, transparent, rgba(253, 249, 238, 0.75), transparent);
  }
  .hero__shooting-star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    box-shadow: 0 0 10px 3px rgba(255, 255, 255, 1), 0 0 26px 8px rgba(255, 255, 255, 0.45);
    z-index: 5;
  }
  .hero__shooting-star::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    width: 200px;
    height: 2px;
    transform: translateY(-50%);
    clip-path: polygon(0% 50%, 100% 0%, 100% 100%);
    background: linear-gradient(90deg,
      transparent 0%, rgba(255, 255, 255, 0.04) 45%, rgba(255, 255, 255, 0.45) 78%, rgba(255, 255, 255, 0.95) 100%);
  }
  .hero__shooting-star--1 {
    top: 12%;
    left: 6%;
    animation: shoot1 15s cubic-bezier(0.16, 0.6, 0.35, 1) infinite;
    animation-delay: 3s;
  }
  .hero__shooting-star--2 {
    top: 5%;
    right: 22%;
    animation: shoot2 21s cubic-bezier(0.16, 0.6, 0.35, 1) infinite;
    animation-delay: 10s;
  }
  .hero__shooting-star--3 {
    top: 34%;
    right: 10%;
    animation: shoot3 26s cubic-bezier(0.16, 0.6, 0.35, 1) infinite;
    animation-delay: 17s;
  }
  /* rotate is set to atan2(dy, dx) of the matching translate below, so the
     tapered trail (which points "west" at rotate:0) always lines up exactly
     opposite the direction of travel. A mismatch here is what made the
     first version look fake. */
  @keyframes shoot1 {
    0%, 5% { opacity: 0; translate: 0 0; rotate: 31.4deg; }
    6% { opacity: 1; }
    10% { opacity: 1; }
    13% { opacity: 0; translate: 360px 220px; rotate: 31.4deg; }
    100% { opacity: 0; translate: 360px 220px; rotate: 31.4deg; }
  }
  @keyframes shoot2 {
    0%, 3% { opacity: 0; translate: 0 0; rotate: 16.7deg; }
    4% { opacity: 1; }
    7% { opacity: 1; }
    9.5% { opacity: 0; translate: 300px 90px; rotate: 16.7deg; }
    100% { opacity: 0; translate: 300px 90px; rotate: 16.7deg; }
  }
  @keyframes shoot3 {
    0%, 4% { opacity: 0; translate: 0 0; rotate: 147.3deg; }
    5% { opacity: 1; }
    8% { opacity: 1; }
    11% { opacity: 0; translate: -280px 180px; rotate: 147.3deg; }
    100% { opacity: 0; translate: -280px 180px; rotate: 147.3deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__star--twinkle { animation: none; }
    .hero__shooting-star { display: none; }
  }
  /* digit columns (binary, matrix-green) rising from the bottom edge and
     dissolving on the way up. Dense at the left/right edges, thinned out
     behind the headline/body column so it frames the copy instead of
     sitting on top of it. Two depths (front/back) give it real space:
     front columns are bigger, brighter, and sharp; back columns are
     smaller, dimmer, and softly blurred, like they're further away. */
  .hero__matrix {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }
  .hero__matrix-col {
    position: absolute;
    bottom: -18%;
    font-family: var(--font-mono);
    line-height: 1.55;
    white-space: pre-line;
    color: var(--matrix-green);
    opacity: 0;
    animation: matrixRise linear infinite;
  }
  .hero__matrix-col--front {
    font-size: 15px;
    text-shadow: 0 0 7px color-mix(in srgb, var(--matrix-green) 70%, transparent);
  }
  .hero__matrix-col--back {
    font-size: 11px;
    filter: blur(0.6px);
    text-shadow: 0 0 4px color-mix(in srgb, var(--matrix-green) 50%, transparent);
  }
  @keyframes matrixRise {
    0% { translate: 0 0; opacity: 0; }
    9% { opacity: var(--peak, 0.4); }
    55% { opacity: calc(var(--peak, 0.4) * 0.6); }
    76% { opacity: 0; }
    100% { translate: 0 calc(var(--rise, 32) * -1vh); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__matrix { display: none; }
  }
  .hero__inner { position: relative; z-index: 3; max-width: 46rem; }
  .hero .eyebrow { color: rgba(255, 244, 224, 0.65); }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-5);
    line-height: 1.05;
    color: #fbf6ec;
    margin: 0.5rem 0 var(--space-3);
  }
  .hero h1 .serif-italic { color: #f3b53d; }
  .hero__pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: rgba(255, 244, 224, 0.55);
    margin: 0 0 var(--space-3);
  }
  .hero__pipeline-word-wrap {
    display: inline-block;
    min-width: 4.5em;
    color: #fbf6ec;
    font-weight: 500;
  }
  html:not(.js) .hero__pipeline-word-wrap { display: none; }
  .hero__sub {
    color: rgba(255, 244, 224, 0.72);
    font-size: var(--step-1);
    max-width: 42rem;
  }
  .hero .btn--primary { background: #fbf6ec; color: #17120b; border-color: #fbf6ec; }
  .hero .btn--primary:hover { background: #f3b53d; border-color: #f3b53d; }
  .hero .btn--ghost { color: #fbf6ec; border-color: rgba(255, 244, 224, 0.5); }
  .hero .btn--ghost:hover { background: rgba(255, 244, 224, 0.12); }
  .hero__ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--ink);
    transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .btn--primary { background: var(--ink); color: var(--paper); }
  .btn--primary:hover { background: var(--ink-soft); }
  .btn--ghost { background: transparent; color: var(--ink); }
  .btn--ghost:hover { background: var(--line); }

  .hero__stamps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .hero__stamps a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: rgba(255, 244, 224, 0.6);
  }
  .hero__stamps a:hover { color: #fbf6ec; }
  .hero__stamp-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--stamp);
    display: inline-block;
  }

  .section-head { max-width: 40rem; margin-bottom: var(--space-5); }
  .section-head h2 {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    margin: 0 0 0.4rem;
  }
  .section-head__sub { color: var(--graphite); margin: 0; }

  /* ---- the reel: the build line, five stops, each project's own color ---- */
  .reel {
    position: relative;
    padding-block: var(--space-6);
    background:
      radial-gradient(70% 50% at 50% 0%, color-mix(in srgb, var(--opal-honey) 6%, transparent), transparent 75%),
      var(--paper);
  }
  .reel__spine {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .reel__spine::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg,
      var(--pl-gold), var(--jarvis-gold), var(--wip-gold), var(--qinty-terracotta), var(--oup-lavender));
    opacity: 0.55;
    transform: translateX(-50%);
  }
  .reel__row { position: relative; overflow: hidden; scroll-margin-top: 5rem; }
  .reel__node {
    position: absolute;
    left: 50%;
    top: 2.2rem;
    width: 11px; height: 11px;
    border-radius: 50%;
    background: var(--row-a);
    border: 3px solid var(--paper);
    transform: translateX(-50%);
    z-index: 2;
  }
  /* whisper-quiet version of the hero's opal shimmer: same drifting-blob
     technique, each project's own two accents, kept just barely visible so
     the real screenshots and copy stay the thing you're actually reading */
  .reel__row-aura {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .reel__row-aura span {
    position: absolute;
    width: 24vw;
    height: 24vw;
    max-width: 320px;
    max-height: 320px;
    min-width: 160px;
    min-height: 160px;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.1;
    animation: auraDrift 34s var(--ease-in-out) infinite;
  }
  .reel__row-aura span:first-child {
    top: -16%; left: -8%;
    background: color-mix(in srgb, var(--row-a) 65%, white 35%);
  }
  .reel__row-aura span:last-child {
    bottom: -18%; right: -6%;
    background: color-mix(in srgb, var(--row-b) 65%, white 35%);
    animation-duration: 28s;
    animation-delay: -12s;
  }
  .reel__row--reverse .reel__row-aura span:first-child { left: auto; right: -8%; }
  .reel__row--reverse .reel__row-aura span:last-child { right: auto; left: -6%; }
  @media (prefers-reduced-motion: reduce) {
    .reel__row-aura span { animation: none; }
  }
  .reel__row-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  .reel__row--reverse .reel__row-inner { direction: rtl; }
  .reel__row--reverse .reel__row-inner > * { direction: ltr; }
  .reel__media {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    border-top: 5px solid var(--row-a);
    background: var(--row-b);
    box-shadow: 0 24px 48px -30px rgba(21, 23, 27, 0.35);
  }
  .reel__media img {
    width: 100%;
    transition: transform var(--dur-narrative) var(--ease-out);
  }
  .reel__media:hover img { transform: scale(1.03); }
  .reel__kind {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--row-b);
    margin: 0 0 0.5rem;
  }
  .reel__copy h3 { margin: 0 0 0.5rem; }
  .reel__copy h3 a {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
    text-decoration: none;
    color: var(--ink);
  }
  .reel__copy h3 a:hover { text-decoration: underline; }
