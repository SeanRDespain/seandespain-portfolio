---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/projects.js";

const capabilities = [
  { label: "Product", items: ["Product architecture", "User flows & progression systems", "Freemium/paywall design", "Booking & conversion funnels"] },
  { label: "Development", items: ["Unity (C#)", "Next.js / React / TypeScript", "Astro", "Firebase", "API integrations", "iOS & Android release"] },
  { label: "Brand & Creative", items: ["Visual identity systems", "Typography systems", "Original character/IP design", "Campaign production"] },
  { label: "Marketing", items: ["SEO", "GA4 & conversion tracking", "JSON-LD structured data", "Lead-generation funnels"] },
];
---
<Layout title="Product Builder & Creative Technologist">
  <Header slot="header" />

  <section class="hero">
    <div class="hero__aura" aria-hidden="true">
      <span class="hero__aura-blob hero__aura-blob--1"></span>
      <span class="hero__aura-blob hero__aura-blob--2"></span>
      <span class="hero__aura-blob hero__aura-blob--3"></span>
      <span class="hero__aura-blob hero__aura-blob--4"></span>
      <span class="hero__aura-blob hero__aura-blob--5"></span>
      <span class="hero__aura-blob hero__aura-blob--6"></span>
    </div>
    <div class="container hero__inner">
      <p class="eyebrow" data-reveal>Product · Brand · Code</p>
      <h1 data-reveal data-reveal-delay="60">
        I design, build, and launch <span class="serif-italic">digital products and brands.</span>
      </h1>

      <p class="hero__pipeline" data-reveal data-reveal-delay="140">
        <span class="hero__pipeline-label">Every venture, the same throughline —</span>
        <span class="hero__pipeline-word-wrap"><span data-pipeline-word>Concept</span></span>
        <noscript>&nbsp;Concept → Brand → UX → Code → Launch → Operate</noscript>
      </p>

      <p class="hero__sub" data-reveal data-reveal-delay="200">
        Five ventures, founded and operated end to end — a wellness app live on the App Store, a
        business platform running four companies, a 50-person staffing company, a bilingual
        conservation program in the Amazon, and a children's entertainment brand. Same person,
        every time.
      </p>
      <div class="hero__ctas" data-reveal data-reveal-delay="260">
        <a class="btn btn--primary" href="#work">View selected work</a>
        <a class="btn btn--ghost" href="/resume/Sean_Despain_Resume_Hybrid_ProductCreativeTech.docx">Download résumé</a>
      </div>

      <ul class="hero__stamps" data-reveal data-reveal-delay="320" aria-label="Jump to a project">
        {projects.map((p) => (
          <li>
            <a href={`#${p.slug}`} style={`--stamp:${p.accent.a}`}>
              <span class="hero__stamp-dot" aria-hidden="true"></span>{p.short}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="work" class="reel">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Five worlds, one builder</h2>
        <p class="section-head__sub">Real, shipped or shipping products — the colors and imagery below are each project's own, not a template applied five times.</p>
      </div>
    </div>

    <div class="reel__spine" role="presentation">
      {projects.map((project, i) => (
        <article
          id={project.slug}
          class="reel__row"
          class:list={[i % 2 === 1 && "reel__row--reverse"]}
          style={`--row-a:${project.accent.a}; --row-b:${project.accent.b};`}
          data-reveal
        >
          <span class="reel__node" style={`--row-a:${project.accent.a};`} aria-hidden="true"></span>
          <div class="container reel__row-inner">
            <a href={`/work/${project.slug}/`} class="reel__media">
              <img src={project.heroImage} alt="" loading="lazy" />
            </a>
            <div class="reel__copy">
              <p class="reel__kind">{project.kind} · {project.years} · {project.status}</p>
              <h3><a href={`/work/${project.slug}/`}>{project.name}</a></h3>
              <p class="reel__tagline">{project.tagline}</p>
              <p class="reel__role">{project.role}</p>
              <p class="reel__tech">{project.tech.slice(0, 4).join(" · ")}</p>
              <a class="reel__cta" href={`/work/${project.slug}/`}>Read the case study →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="capabilities">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>What that actually means</h2>
        <p class="section-head__sub">Capability comes from the work above — nothing here is a claim without a project behind it.</p>
      </div>
      <div class="capabilities__grid">
        {capabilities.map((group, i) => (
          <div class="capabilities__group" data-reveal data-reveal-delay={i * 60}>
            <p class="eyebrow">{group.label}</p>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <a class="text-link" href="/capabilities/">See the full capability → project matrix →</a>
    </div>
  </section>

  <section class="about-teaser">
    <div class="container about-teaser__inner" data-reveal>
      <p class="serif-italic about-teaser__quote">
        "I don't hand off any part of the pipeline. I identify the need, design the brand and the
        UX, build the working software, write the launch systems, then operate the result."
      </p>
      <a class="btn btn--ghost" href="/about/">More about how I work →</a>
    </div>
  </section>

  <Footer slot="footer" />

  <script>
    import "../scripts/reveal.js";
    import "../scripts/pipeline-cycle.js";
  </script>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--opal-base);
    padding-block: var(--space-7) var(--space-6);
  }
  .hero__aura {
    position: absolute;
    inset: -15% -15% -35% -15%;
    z-index: 0;
    pointer-events: none;
  }
  .hero__aura-blob {
    position: absolute;
    width: 34vw;
    height: 34vw;
    max-width: 480px;
    max-height: 480px;
    min-width: 260px;
    min-height: 260px;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.4;
    mix-blend-mode: multiply;
    animation: auraDrift 22s var(--ease-in-out) infinite, auraShimmer 6s ease-in-out infinite;
  }
  .hero__aura-blob--1 {
    top: -14%; left: -8%;
    background: var(--opal-honey);
    animation-duration: 21s, 5.5s;
  }
  .hero__aura-blob--2 {
    top: -18%; right: -18%;
    width: 30vw; height: 30vw; max-width: 420px; max-height: 420px;
    background: var(--opal-violet);
    animation-duration: 27s, 7s;
    animation-delay: -6s, -1s;
  }
  .hero__aura-blob--3 {
    bottom: -18%; left: 14%;
    background: var(--opal-fire);
    animation-duration: 31s, 6.5s;
    animation-delay: -13s, -3s;
  }
  .hero__aura-blob--4 {
    bottom: -12%; right: 8%;
    background: var(--opal-mint);
    animation-duration: 25s, 8s;
    animation-delay: -19s, -4.5s;
  }
  .hero__aura-blob--5 {
    top: 22%; left: 32%;
    width: 24vw; height: 24vw; max-width: 340px; max-height: 340px; min-width: 200px; min-height: 200px;
    background: var(--opal-jade);
    animation-duration: 29s, 7.5s;
    animation-delay: -9s, -2s;
  }
  .hero__aura-blob--6 {
    top: 8%; right: 26%;
    width: 22vw; height: 22vw; max-width: 300px; max-height: 300px; min-width: 180px; min-height: 180px;
    background: var(--opal-sapphire);
    animation-duration: 33s, 9s;
    animation-delay: -24s, -5.5s;
  }
  @keyframes auraDrift {
    0%, 100% { translate: 0 0; scale: 1; }
    33% { translate: 4% 6%; scale: 1.1; }
    66% { translate: -5% -3%; scale: 0.92; }
  }
  @keyframes auraShimmer {
    0%, 100% { opacity: 0.28; }
    50% { opacity: 0.48; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__aura-blob { animation: none; opacity: 0.36; }
  }
  .hero__inner { position: relative; z-index: 1; max-width: 46rem; }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-5);
    line-height: 1.05;
    margin: 0.5rem 0 var(--space-3);
  }
  .hero__pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite);
    margin: 0 0 var(--space-3);
  }
  .hero__pipeline-word-wrap {
    display: inline-block;
    min-width: 4.5em;
    color: var(--ink);
    font-weight: 500;
  }
  html:not(.js) .hero__pipeline-word-wrap { display: none; }
  .hero__sub {
    color: var(--graphite);
    font-size: var(--step-1);
    max-width: 42rem;
  }
  .hero__ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--ink);
    transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .btn--primary { background: var(--ink); color: var(--paper); }
  .btn--primary:hover { background: var(--ink-soft); }
  .btn--ghost { background: transparent; color: var(--ink); }
  .btn--ghost:hover { background: var(--line); }

  .hero__stamps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .hero__stamps a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--graphite);
  }
  .hero__stamps a:hover { color: var(--ink); }
  .hero__stamp-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--stamp);
    display: inline-block;
  }

  .section-head { max-width: 40rem; margin-bottom: var(--space-5); }
  .section-head h2 {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    margin: 0 0 0.4rem;
  }
  .section-head__sub { color: var(--graphite); margin: 0; }

  /* ---- the reel: the build line, five stops, each project's own color ---- */
  .reel {
    position: relative;
    padding-block: var(--space-6);
    background:
      radial-gradient(70% 50% at 50% 0%, color-mix(in srgb, var(--opal-honey) 6%, transparent), transparent 75%),
      var(--paper);
  }
  .reel__spine {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .reel__spine::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg,
      var(--pl-gold), var(--jarvis-gold), var(--wip-gold), var(--qinty-terracotta), var(--oup-lavender));
    opacity: 0.55;
    transform: translateX(-50%);
  }
  .reel__row { position: relative; scroll-margin-top: 5rem; }
  .reel__node {
    position: absolute;
    left: 50%;
    top: 2.2rem;
    width: 11px; height: 11px;
    border-radius: 50%;
    background: var(--row-a);
    border: 3px solid var(--paper);
    transform: translateX(-50%);
    z-index: 2;
  }
  .reel__row-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  .reel__row--reverse .reel__row-inner { direction: rtl; }
  .reel__row--reverse .reel__row-inner > * { direction: ltr; }
  .reel__media {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    border-top: 5px solid var(--row-a);
    background: var(--row-b);
    box-shadow: 0 24px 48px -30px rgba(21, 23, 27, 0.35);
  }
  .reel__media img {
    width: 100%;
    transition: transform var(--dur-narrative) var(--ease-out);
  }
  .reel__media:hover img { transform: scale(1.03); }
  .reel__kind {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--row-b);
    margin: 0 0 0.5rem;
  }
  .reel__copy h3 { margin: 0 0 0.5rem; }
  .reel__copy h3 a {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
    text-decoration: none;
    color: var(--ink);
  }
  .reel__copy h3 a:hover { text-decoration: underline; }
  .reel__tagline { font-size: var(--step-0); color: var(--ink); margin: 0 0 0.6rem; }
  .reel__role { font-family: var(--font-mono); font-size: var(--step--1); color: var(--graphite); margin: 0 0 0.3rem; }
  .reel__tech { font-family: var(--font-mono); font-size: 0.72rem; color: var(--graphite); margin: 0 0 var(--space-3); }
  .reel__cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .capabilities {
    position: relative;
    padding-block: var(--space-6);
    background:
      radial-gradient(55% 85% at 6% -10%, color-mix(in srgb, var(--opal-honey) 16%, transparent), transparent 70%),
      radial-gradient(50% 80% at 100% 10%, color-mix(in srgb, var(--opal-sapphire) 14%, transparent), transparent 70%),
      radial-gradient(55% 85% at 90% 110%, color-mix(in srgb, var(--opal-violet) 16%, transparent), transparent 70%),
      var(--paper-raised);
    border-block: 1px solid var(--line);
  }
  .capabilities__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .capabilities__group ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .text-link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }

  .about-teaser {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-7);
    background:
      radial-gradient(45% 70% at 30% 30%, color-mix(in srgb, var(--opal-fire) 9%, transparent), transparent 72%),
      radial-gradient(45% 70% at 75% 65%, color-mix(in srgb, var(--opal-jade) 10%, transparent), transparent 72%);
  }
  .about-teaser__inner { position: relative; max-width: 42rem; }
  .about-teaser__quote {
    font-size: var(--step-3);
    line-height: 1.3;
    margin: 0 0 var(--space-4);
  }

  @media (max-width: 860px) {
    .reel__spine::before { left: var(--space-3); }
    .reel__node { left: var(--space-3); top: 1.4rem; }
    .reel__row-inner {
      grid-template-columns: 1fr;
      padding-left: var(--space-5);
    }
    .reel__row--reverse .reel__row-inner { direction: ltr; }
  }
</style>
