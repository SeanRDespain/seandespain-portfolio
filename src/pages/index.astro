---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/projects.js";

const capabilities = [
  { label: "Product", items: ["Product architecture", "User flows & progression systems", "Freemium/paywall design", "Booking & conversion funnels"] },
  { label: "Development", items: ["Unity (C#)", "Next.js / React / TypeScript", "Astro", "Firebase", "API integrations", "iOS & Android release"] },
  { label: "Brand & Creative", items: ["Visual identity systems", "Typography systems", "Original character/IP design", "Campaign production"] },
  { label: "Marketing", items: ["SEO", "GA4 & conversion tracking", "JSON-LD structured data", "Lead-generation funnels"] },
];

// deterministic starfield: same build, same sky, so screenshots/QA are stable
function seededRandom(seed) {
  let s = seed;
  return () => {
    s = (s * 1103515245 + 12345) & 0x7fffffff;
    return s / 0x7fffffff;
  };
}
const rand = seededRandom(1337);
const stars = Array.from({ length: 160 }).map((_, i) => {
  const big = i % 9 === 0;
  return {
    top: (rand() * 100).toFixed(1),
    left: (rand() * 100).toFixed(1),
    size: big ? (2.1 + rand() * 1.5).toFixed(2) : (1 + rand() * 0.9).toFixed(2),
    opacity: (big ? 0.8 : 0.5) + rand() * 0.4,
    twinkle: i % 3 !== 2,
    flare: big && i % 27 === 0,
    tint: i % 5 === 0,
    delay: (rand() * 6).toFixed(2),
    duration: (3 + rand() * 3).toFixed(2),
  };
});

// matrix-style digit columns rising from the bottom edge and dissolving
// partway up. Denser at the edges, thinned out behind the headline/body
// text column (roughly 26-72% of the width) so the effect frames the
// copy instead of fighting it. Two "depths" (front: bigger, brighter,
// sharper; back: smaller, dimmer, slightly blurred) give it read as a
// field with real space in it, not a flat wall of digits.
const COLS = 38;
const matrixCols = Array.from({ length: COLS }).map((_, i) => {
  const left = 1 + (i / (COLS - 1)) * 98 + (rand() * 2.2 - 1.1);
  const inTextZone = left > 26 && left < 72;
  const front = rand() > 0.55;
  const digitCount = front ? 12 : 8;
  const digits = Array.from({ length: digitCount })
    .map(() => (rand() > 0.5 ? "1" : "0"))
    .join("");
  return {
    left: left.toFixed(1),
    digits,
    front,
    delay: (rand() * 10).toFixed(2),
    duration: (front ? 6 + rand() * 4 : 9 + rand() * 6).toFixed(2),
    rise: (front ? 34 + rand() * 14 : 22 + rand() * 12).toFixed(0),
    peakOpacity: ((front ? 0.55 : 0.32) * (inTextZone ? 0.4 : 1)).toFixed(2),
  };
});

// opening sequence: each letter starts as a binary digit and decodes into
// place (see scripts/intro.js)
const introChars = "SEAN DESPAIN".split("").map((ch) => ({
  ch,
  seed: rand() > 0.5 ? "1" : "0",
}));
---
<Layout title="Product Builder & Creative Technologist">
  <Fragment slot="head">
    <script is:inline>
      // Decide before first paint whether the opening sequence plays, so the
      // hero never flashes underneath it. Once per session, never with
      // reduced motion, never when arriving at a #section link. ?intro
      // replays it on demand.
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var force = /[?&]intro\b/.test(location.search);
          if (!force && (location.hash || sessionStorage.getItem("sd-intro-seen"))) return;
          document.documentElement.classList.add("intro-active");
        } catch (e) {}
      })();
    </script>
  </Fragment>
  <Header slot="header" />

  <div class="intro" data-intro aria-hidden="true">
    <div class="intro__half intro__half--top">
      <p class="intro__name">
        {introChars.map((c) =>
          c.ch === " "
            ? <span class="intro__char intro__char--space">&nbsp;</span>
            : <span class="intro__char" data-char={c.ch}>{c.seed}</span>
        )}
      </p>
      <span class="intro__edge"></span>
    </div>
    <div class="intro__half intro__half--bottom">
      <p class="intro__tag">Product · Brand · Code</p>
      <span class="intro__edge"></span>
    </div>
    <span class="intro__line"></span>
    <canvas class="intro__stars"></canvas>
  </div>

  <section class="hero">
    <div class="hero__aura" aria-hidden="true">
      <span class="hero__glow hero__glow--band"></span>
      <span class="hero__glow hero__glow--indigo"></span>
      <span class="hero__glow hero__glow--teal"></span>
      <span class="hero__stars">
        {stars.map((s) => (
          <span
            class:list={["hero__star", s.twinkle && "hero__star--twinkle", s.flare && "hero__star--flare", s.tint && "hero__star--tint"]}
            style={`top:${s.top}%; left:${s.left}%; width:${s.size}px; height:${s.size}px; opacity:${s.opacity.toFixed(2)}; --star-o:${s.opacity.toFixed(2)}; animation-delay:${s.delay}s; animation-duration:${s.duration}s;`}
          ></span>
        ))}
      </span>
      <span class="hero__shooting-star hero__shooting-star--1"></span>
      <span class="hero__shooting-star hero__shooting-star--2"></span>
      <span class="hero__shooting-star hero__shooting-star--3"></span>
      <span class="hero__matrix">
        {matrixCols.map((col) => (
          <span
            class:list={["hero__matrix-col", col.front ? "hero__matrix-col--front" : "hero__matrix-col--back"]}
            style={`left:${col.left}%; animation-delay:${col.delay}s; animation-duration:${col.duration}s; --rise:${col.rise}; --peak:${col.peakOpacity};`}
          >{col.digits.split("").join("\n")}</span>
        ))}
      </span>
      <span class="hero__aura-vignette"></span>
    </div>
    <div class="container hero__inner">
      <p class="eyebrow" data-reveal>Product · Brand · Code</p>
      <h1 data-reveal data-reveal-delay="60">
        I design, build, and launch <span class="serif-italic">digital products and brands.</span>
      </h1>

      <p class="hero__pipeline" data-reveal data-reveal-delay="140">
        <span class="hero__pipeline-label">Bring me the idea. I'll handle the</span>
        <span class="hero__pipeline-word-wrap"><span data-pipeline-word>strategy</span></span>
        <noscript>&nbsp;strategy, brand, design, code, launch, and marketing.</noscript>
      </p>

      <p class="hero__sub" data-reveal data-reveal-delay="200">
        Apps, websites, business software, brands, and the marketing that puts them in front of
        people. Whatever you need built, I can take it from a rough idea to something real people
        use. Below are a few highlights: an app on the App Store, software that runs day-to-day
        operations for several companies, and brands built from a blank page.
      </p>
      <div class="hero__ctas" data-reveal data-reveal-delay="260">
        <a class="btn btn--primary" href="#work">View selected work</a>
        <a class="btn btn--ghost" href="/resume/Sean_Despain_Resume_Hybrid_ProductCreativeTech.pdf" download>Download résumé</a>
      </div>

      <ul class="hero__stamps" data-reveal data-reveal-delay="320" aria-label="Jump to a project">
        {projects.map((p) => (
          <li>
            <a href={`#${p.slug}`} style={`--stamp:${p.accent.a}`}>
              <span class="hero__stamp-dot" aria-hidden="true"></span>{p.short}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="work" class="reel">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>A few things I've built</h2>
        <p class="section-head__sub">Highlights, not the full list. Different industries, different problems, and a different mix of design, code, brand, and marketing every time.</p>
      </div>
    </div>

    <div class="reel__spine" role="presentation">
      {projects.map((project, i) => (
        <article
          id={project.slug}
          class="reel__row"
          class:list={[i % 2 === 1 && "reel__row--reverse"]}
          style={`--row-a:${project.accent.a}; --row-b:${project.accent.b};`}
          data-reveal
        >
          <span class="reel__node" style={`--row-a:${project.accent.a};`} aria-hidden="true"></span>
          <span class="reel__row-aura" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <div class="container reel__row-inner">
            <a href={`/work/${project.slug}/`} class="reel__media">
              <img src={project.heroImage} alt="" loading="lazy" />
            </a>
            <div class="reel__copy">
              <p class="reel__kind">{project.kind} · {project.years} · {project.status}</p>
              <h3><a href={`/work/${project.slug}/`}>{project.name}</a></h3>
              <p class="reel__tagline">{project.tagline}</p>
              <p class="reel__role">{project.role}</p>
              <p class="reel__tech">{project.tech.slice(0, 4).join(" · ")}</p>
              <a class="reel__cta" href={`/work/${project.slug}/`}>Read the case study →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="capabilities">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>What I can take on</h2>
        <p class="section-head__sub">The skills behind the projects above, ready to put to work on whatever you're building next.</p>
      </div>
      <div class="capabilities__grid">
        {capabilities.map((group, i) => (
          <div class="capabilities__group" data-reveal data-reveal-delay={i * 60}>
            <p class="eyebrow">{group.label}</p>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <a class="text-link" href="/capabilities/">See the full capability → project matrix →</a>
    </div>
  </section>

  <section class="about-teaser">
    <div class="container about-teaser__inner" data-reveal>
      <p class="serif-italic about-teaser__quote">
        "I don't hand off any part of the pipeline. I identify the need, design the brand and the
        UX, build the working software, write the launch systems, then operate the result."
      </p>
      <a class="btn btn--ghost" href="/about/">More about how I work →</a>
    </div>
  </section>

  <Footer slot="footer" />

  <script>
    import "../scripts/reveal.js";
    import "../scripts/pipeline-cycle.js";
    import "../scripts/intro.js";
  </script>
</Layout>

<style is:global>
  /* ---- opening sequence (first load per session, see scripts/intro.js) ----
     Hidden unless the head script added html.intro-active before first
     paint. If the script never runs, a CSS failsafe fades the overlay out
     after 4.5s so the page can never get stuck behind it. */
  @property --intro-ls {
    syntax: "<length>";
    inherits: true;
    initial-value: 0.42em;
  }
  .intro { display: none; }
  html.intro-active .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 200;
    overflow: hidden;
    animation: introFailsafe 0.6s ease 4.5s forwards;
  }
  html.intro-active .intro.is-running { animation: none; }
  @keyframes introFailsafe {
    to { opacity: 0; visibility: hidden; }
  }
  html.intro-active .hero__aura {
    opacity: 0.2;
    transform: scale(1.06);
    animation: introAuraFailsafe 0.6s ease 4.5s forwards;
  }
  @keyframes introAuraFailsafe {
    to { opacity: 1; transform: none; }
  }

  /* two halves of one night: mirrored gradients meet at the seam, where a
     soft indigo glow sits right behind the name */
  .intro__half {
    position: absolute;
    left: 0;
    right: 0;
    height: calc(50% + 1px);
    will-change: transform;
  }
  .intro__half--top {
    top: 0;
    background:
      radial-gradient(60% 70% at 50% 100%, rgba(79, 91, 213, 0.22), transparent 70%),
      linear-gradient(180deg, #03050d 0%, #070b1c 55%, #0c1330 100%);
  }
  .intro__half--bottom {
    bottom: 0;
    background:
      radial-gradient(60% 70% at 50% 0%, rgba(79, 91, 213, 0.22), transparent 70%),
      linear-gradient(0deg, #03050d 0%, #070b1c 55%, #0c1330 100%);
  }

  .intro__name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.1rem, 3.4vh, 2.1rem);
    margin: 0;
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1.1rem, 2.6vw, 2.1rem);
    line-height: 1;
    opacity: 0;
  }
  .intro__char {
    display: inline-block;
    width: 1ch;
    margin: 0 calc(var(--intro-ls) / 2);
    color: rgba(169, 184, 255, 0.5);
  }
  .intro__char.is-locked {
    color: var(--night-ice);
    text-shadow: 0 0 10px rgba(169, 184, 255, 0.35);
    animation: introCharLock 0.9s ease-out;
  }
  @keyframes introCharLock {
    0% { color: #fff; text-shadow: 0 0 14px #fff, 0 0 30px rgba(169, 184, 255, 0.9); }
    100% { text-shadow: 0 0 10px rgba(169, 184, 255, 0.35); }
  }

  .intro__tag {
    position: absolute;
    left: 0;
    right: 0;
    top: clamp(1.1rem, 3.4vh, 2.1rem);
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: clamp(0.64rem, 0.9vw, 0.76rem);
    letter-spacing: 0.38em;
    padding-left: 0.38em;
    text-transform: uppercase;
    color: rgba(var(--night-text), 0.6);
    opacity: 0;
  }

  /* the line of light: draws out from the center, then tears into the two
     edges that ride the halves apart */
  .intro__line,
  .intro__edge {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%, rgba(169, 184, 255, 0.5) 18%, #fff 50%, rgba(169, 184, 255, 0.5) 82%, transparent 100%);
    opacity: 0;
  }
  .intro__line::after,
  .intro__edge::after {
    content: "";
    position: absolute;
    inset: -4px 0;
    background: inherit;
    filter: blur(5px);
  }
  .intro__line {
    top: 50%;
    margin-top: -0.5px;
    transform: scaleX(0);
    z-index: 2;
  }
  .intro__half--top .intro__edge { bottom: 0; }
  .intro__half--bottom .intro__edge { top: 0; }

  .intro__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
  }
</style>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(130% 100% at 22% 0%, var(--night-top) 0%, var(--night-mid) 55%, var(--night-deep) 100%);
    padding-block: var(--space-7) var(--space-6);
  }
  .hero__aura {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .hero__aura-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(85% 75% at 50% 35%, transparent 45%, rgba(3, 5, 14, 0.55) 100%);
    z-index: 1;
  }
  /* slow-drifting glows: an indigo nebula top-right, a teal one bottom-left,
     and a soft diagonal band between them, like the Milky Way crossing the
     sky. Calm depth and color, nothing literal. */
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    mix-blend-mode: screen;
    opacity: 0.3;
    animation: glowDrift 42s var(--ease-in-out) infinite;
  }
  .hero__glow--indigo {
    top: -18%;
    right: -12%;
    width: 46vw;
    height: 46vw;
    max-width: 620px;
    max-height: 620px;
    min-width: 340px;
    min-height: 340px;
    background: var(--night-indigo);
    opacity: 0.42;
  }
  .hero__glow--band {
    top: 8%;
    left: -10%;
    width: 120%;
    height: 34%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--night-violet), color-mix(in srgb, var(--night-indigo) 60%, transparent) 55%, transparent);
    rotate: -14deg;
    filter: blur(70px);
    opacity: 0.22;
    animation-duration: 60s;
    animation-delay: -30s;
  }
  .hero__glow--teal {
    bottom: -22%;
    left: -14%;
    width: 40vw;
    height: 40vw;
    max-width: 540px;
    max-height: 540px;
    min-width: 300px;
    min-height: 300px;
    background: color-mix(in srgb, var(--pl-teal) 60%, #1e5a8a 40%);
    opacity: 0.38;
    animation-duration: 50s;
    animation-delay: -18s;
  }
  @keyframes glowDrift {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: 3% 4%; scale: 1.08; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__glow { animation: none; }
  }
  .hero__stars { position: absolute; inset: 0; z-index: 1; }
  .hero__star {
    position: absolute;
    border-radius: 50%;
    background: var(--night-ice);
  }
  .hero__star--tint { background: var(--night-periwinkle); }
  .hero__star--twinkle { animation: starTwinkle 4s ease-in-out infinite; }
  @keyframes starTwinkle {
    0%, 100% { opacity: var(--star-o, 0.5); scale: 1; }
    50% { opacity: 0.15; scale: 0.7; }
  }
  /* a handful of the brightest stars get a four-point glint, the way real
     bright stars flare through a camera lens. Rare on purpose. */
  .hero__star--flare::before,
  .hero__star--flare::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: linear-gradient(90deg, transparent, rgba(var(--night-text), 0.8), transparent);
    translate: -50% -50%;
  }
  .hero__star--flare::before { width: 24px; height: 1px; }
  .hero__star--flare::after {
    width: 1px;
    height: 24px;
    background: linear-gradient(180deg, transparent, rgba(var(--night-text), 0.8), transparent);
  }
  .hero__shooting-star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    box-shadow: 0 0 10px 3px rgba(255, 255, 255, 1), 0 0 26px 8px rgba(255, 255, 255, 0.45);
    z-index: 5;
  }
  .hero__shooting-star::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    width: 200px;
    height: 2px;
    transform: translateY(-50%);
    clip-path: polygon(0% 50%, 100% 0%, 100% 100%);
    background: linear-gradient(90deg,
      transparent 0%, rgba(255, 255, 255, 0.04) 45%, rgba(255, 255, 255, 0.45) 78%, rgba(255, 255, 255, 0.95) 100%);
  }
  .hero__shooting-star--1 {
    top: 12%;
    left: 6%;
    animation: shoot1 15s cubic-bezier(0.16, 0.6, 0.35, 1) infinite;
    animation-delay: 3s;
  }
  .hero__shooting-star--2 {
    top: 5%;
    right: 22%;
    animation: shoot2 21s cubic-bezier(0.16, 0.6, 0.35, 1) infinite;
    animation-delay: 10s;
  }
  .hero__shooting-star--3 {
    top: 34%;
    right: 10%;
    animation: shoot3 26s cubic-bezier(0.16, 0.6, 0.35, 1) infinite;
    animation-delay: 17s;
  }
  /* rotate is set to atan2(dy, dx) of the matching translate below, so the
     tapered trail (which points "west" at rotate:0) always lines up exactly
     opposite the direction of travel. A mismatch here is what made the
     first version look fake. */
  @keyframes shoot1 {
    0%, 5% { opacity: 0; translate: 0 0; rotate: 31.4deg; }
    6% { opacity: 1; }
    10% { opacity: 1; }
    13% { opacity: 0; translate: 360px 220px; rotate: 31.4deg; }
    100% { opacity: 0; translate: 360px 220px; rotate: 31.4deg; }
  }
  @keyframes shoot2 {
    0%, 3% { opacity: 0; translate: 0 0; rotate: 16.7deg; }
    4% { opacity: 1; }
    7% { opacity: 1; }
    9.5% { opacity: 0; translate: 300px 90px; rotate: 16.7deg; }
    100% { opacity: 0; translate: 300px 90px; rotate: 16.7deg; }
  }
  @keyframes shoot3 {
    0%, 4% { opacity: 0; translate: 0 0; rotate: 147.3deg; }
    5% { opacity: 1; }
    8% { opacity: 1; }
    11% { opacity: 0; translate: -280px 180px; rotate: 147.3deg; }
    100% { opacity: 0; translate: -280px 180px; rotate: 147.3deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__star--twinkle { animation: none; }
    .hero__shooting-star { display: none; }
  }
  /* digit columns (binary, starlight white) rising from the bottom edge and
     dissolving on the way up. Dense at the left/right edges, thinned out
     behind the headline/body column so it frames the copy instead of
     sitting on top of it. Two depths (front/back) give it real space:
     front columns are bigger, brighter, and sharp; back columns are
     smaller, dimmer, and softly blurred, like they're further away. */
  .hero__matrix {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }
  .hero__matrix-col {
    position: absolute;
    bottom: -18%;
    font-family: var(--font-mono);
    line-height: 1.55;
    white-space: pre-line;
    color: var(--night-ice);
    opacity: 0;
    animation: matrixRise linear infinite;
  }
  .hero__matrix-col--front {
    font-size: 15px;
    text-shadow: 0 0 8px rgba(var(--night-text), 0.6), 0 0 18px rgba(169, 184, 255, 0.25);
  }
  .hero__matrix-col--back {
    font-size: 11px;
    filter: blur(0.6px);
    text-shadow: 0 0 4px rgba(var(--night-text), 0.4);
  }
  @keyframes matrixRise {
    0% { translate: 0 0; opacity: 0; }
    9% { opacity: var(--peak, 0.4); }
    55% { opacity: calc(var(--peak, 0.4) * 0.6); }
    76% { opacity: 0; }
    100% { translate: 0 calc(var(--rise, 32) * -1vh); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__matrix { display: none; }
  }
  .hero__inner { position: relative; z-index: 3; max-width: 46rem; }
  .hero .eyebrow { color: rgba(var(--night-text), 0.62); }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-5);
    line-height: 1.05;
    color: var(--night-ice);
    margin: 0.5rem 0 var(--space-3);
  }
  .hero h1 .serif-italic {
    color: var(--night-periwinkle);
    background: linear-gradient(100deg, #b9c7ff 0%, var(--night-periwinkle) 45%, #b3a4ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero__pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
