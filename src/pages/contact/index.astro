---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

// Same keys the server validates against (netlify/lib/model.js)
const services = [
  ["app", "An app"],
  ["website", "A website"],
  ["software", "Business software"],
  ["brand", "Brand identity"],
  ["marketing", "Marketing & launch"],
  ["multiple", "Several of these"],
  ["not_sure", "Not sure yet"],
];
const budgets = [
  ["under_2500", "Under $2,500"],
  ["2500_10000", "$2,500 to $10,000"],
  ["10000_25000", "$10,000 to $25,000"],
  ["25000_plus", "$25,000 or more"],
  ["unsure", "Not sure yet"],
];
const timelines = [
  ["asap", "As soon as possible"],
  ["1_3_months", "In 1 to 3 months"],
  ["3_plus_months", "3+ months out"],
  ["flexible", "Flexible"],
];
const heard = [
  ["linkedin", "LinkedIn"],
  ["google_organic", "Google search"],
  ["referral", "A referral or word of mouth"],
  ["saw_work", "I saw something Sean built"],
  ["other", "Somewhere else"],
];
---
<Layout title="Contact" description="Tell Sean Despain about your project, or get in touch about a role.">
  <Header slot="header" />

  <section class="contact">
    <div class="container contact__inner">
      <p class="eyebrow" data-reveal>Contact</p>
      <h1 data-reveal data-reveal-delay="60">Let's talk about what you're building.</h1>
      <p class="contact__sub" data-reveal data-reveal-delay="100">
        Tell me a little about it below and I'll reply personally. Prefer email? That works too.
      </p>

      <form id="inquiry" class="inquiry" action="/api/inquiry" method="post" data-inquiry-form data-reveal data-reveal-delay="140">
        <div data-inquiry-fields>
          <fieldset class="inquiry__type">
            <legend>What's this about?</legend>
            <label><input type="radio" name="type" value="client_work" checked required /> <span>A project I need built</span></label>
            <label><input type="radio" name="type" value="employment" /> <span>A job or contract role</span></label>
            <label><input type="radio" name="type" value="general" /> <span>A question</span></label>
          </fieldset>

          <div class="inquiry__row">
            <label class="inquiry__field">
              <span>Your name</span>
              <input name="name" autocomplete="name" required maxlength="120" />
            </label>
            <label class="inquiry__field">
              <span>Email</span>
              <input name="email" type="email" autocomplete="email" required maxlength="254" />
            </label>
          </div>

          <div class="inquiry__row">
            <label class="inquiry__field">
              <span>Company <em>(optional)</em></span>
              <input name="company" autocomplete="organization" maxlength="120" />
            </label>
            <label class="inquiry__field" data-project-only>
              <span>What do you need? <em>(optional)</em></span>
              <select name="service">
                <option value="">Choose one</option>
                {services.map(([k, label]) => <option value={k}>{label}</option>)}
              </select>
            </label>
          </div>

          <div class="inquiry__row" data-project-only>
            <label class="inquiry__field">
              <span>Budget <em>(optional)</em></span>
              <select name="budget">
                <option value="">Choose a range</option>
                {budgets.map(([k, label]) => <option value={k}>{label}</option>)}
              </select>
            </label>
            <label class="inquiry__field">
              <span>Timeline <em>(optional)</em></span>
              <select name="timeline">
                <option value="">Choose one</option>
                {timelines.map(([k, label]) => <option value={k}>{label}</option>)}
              </select>
            </label>
          </div>

          <label class="inquiry__field">
            <span>Tell me about it</span>
            <textarea name="message" rows="5" required minlength="10" maxlength="4000" placeholder="What you need, who it's for, and anything you already have in place."></textarea>
          </label>

          <label class="inquiry__field">
            <span>How did you find me? <em>(optional)</em></span>
            <select name="heard">
              <option value="">Choose one</option>
              {heard.map(([k, label]) => <option value={k}>{label}</option>)}
            </select>
          </label>

          <!-- bot traps: a field people never see, and the time the form was shown -->
          <label class="inquiry__trap" aria-hidden="true">Website <input name="website_url" tabindex="-1" autocomplete="off" /></label>
          <input type="hidden" name="t" value="" />
          <!-- one key per form view: a retried or double-clicked send saves once -->
          <input type="hidden" name="idem" value="" />

          <p class="inquiry__status" data-inquiry-status role="alert" hidden></p>
          <button type="submit" class="btn btn--primary">Send it</button>
          <p class="inquiry__privacy">Your details go only to me, and are only used to reply.</p>
        </div>

        <div class="inquiry__sent" data-inquiry-sent tabindex="-1" hidden>
          <p class="inquiry__sent-title">Thanks, it's on its way to me.</p>
          <p>I'll reply personally. If it's urgent, email me at seandespain@gmail.com.</p>
        </div>
      </form>

      <h2 class="contact__or" data-reveal>Or reach me directly</h2>
      <ul class="contact__list" data-reveal>
        <li>
          <span class="eyebrow">Email</span>
          <a href="mailto:seandespain@gmail.com">seandespain@gmail.com</a>
        </li>
        <li>
          <span class="eyebrow">LinkedIn</span>
          <a href="https://www.linkedin.com/in/sean-despain-560316116/" target="_blank" rel="noopener noreferrer">linkedin.com/in/sean-despain</a>
        </li>
        <li>
          <span class="eyebrow">Résumé</span>
          <a href="/resume/Sean_Despain_Resume_Hybrid_ProductCreativeTech.pdf" download>Download my résumé (PDF)</a>
          <a class="contact__alt" href="/resume/Sean_Despain_Resume_Hybrid_ProductCreativeTech.docx" download>Need a Word file? Download the .docx</a>
        </li>
      </ul>
    </div>
  </section>

  <Footer slot="footer" />

  <script>
    import "../../scripts/reveal.js";
    import "../../scripts/inquiry-form.js";
  </script>
</Layout>

<style>
  .contact { padding-block: var(--space-7); }
  .contact__inner { max-width: 40rem; }
  .contact h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    margin: 0.4rem 0 0.3rem;
  }
  .contact__sub { color: var(--graphite); margin-bottom: var(--space-4); }

  .inquiry {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-raised, #fff);
    padding: var(--space-4);
    scroll-margin-top: 5rem;
  }
  .inquiry [data-inquiry-fields] { display: grid; gap: var(--space-3); }
  .inquiry__type { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .inquiry__type legend {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--graphite);
    margin-bottom: 0.6rem;
  }
  .inquiry__type label { position: relative; cursor: pointer; }
  .inquiry__type input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .inquiry__type span {
    display: inline-block;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--step--1);
    font-family: var(--font-mono);
    transition: background var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
  }
  .inquiry__type input:checked + span { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .inquiry__type input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }
  .inquiry__row { display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
  .inquiry__row[hidden], .inquiry__field[hidden] { display: none; }
  @media (min-width: 640px) { .inquiry__row { grid-template-columns: 1fr 1fr; } }
  .inquiry__field { display: grid; gap: 0.35rem; }
  .inquiry__field > span { font-size: var(--step--1); font-weight: 600; }
  .inquiry__field em { font-style: normal; font-weight: 400; color: var(--graphite); }
  .inquiry input, .inquiry select, .inquiry textarea {
    font: inherit;
    font-size: var(--step-0);
    padding: 0.7rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    width: 100%;
  }
  .inquiry textarea { resize: vertical; min-height: 8rem; }
  .inquiry__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .inquiry .btn {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }
  .inquiry .btn:disabled { opacity: 0.6; cursor: wait; }
  .inquiry__status { margin: 0; padding: 0.7rem 0.9rem; border-radius: var(--radius-sm); background: #fbeaea; color: #8a1f1f; font-size: var(--step--1); }
  .inquiry__privacy { margin: 0; font-size: var(--step--1); color: var(--graphite); }
  .inquiry__sent { outline: none; }
  .inquiry__sent-title { font-family: var(--font-display); font-size: var(--step-3); margin: 0 0 0.4rem; }

  .contact__or {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--graphite);
    margin: var(--space-6) 0 var(--space-3);
  }
  .contact__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .contact__list li { display: flex; flex-direction: column; gap: 0.2rem; border-bottom: 1px solid var(--line); padding-bottom: var(--space-2); }
  .contact__list a { font-size: var(--step-1); text-decoration: none; border-bottom: 1px solid var(--ink); width: fit-content; }
  .contact__list a.contact__alt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite);
    border-bottom-color: var(--line);
    margin-top: 0.3rem;
  }
</style>
