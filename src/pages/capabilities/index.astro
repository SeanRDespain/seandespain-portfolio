---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const groups = [
  {
    label: "Product",
    items: ["Product architecture", "User flows & progression systems", "Information architecture", "Freemium/paywall design", "Booking & conversion funnels", "Multi-organization system design"],
    tools: ["Figma-style prototyping to shipped UI", "Astro & static-site architecture", "Content-governance systems"],
  },
  {
    label: "Development",
    items: ["Unity (C#)", "Firebase (Auth, Realtime Database)", "Next.js / React / TypeScript", "Tailwind CSS", "Astro", "Node.js", "iOS build & App Store release", "Android/Gradle builds", "API integrations"],
    tools: ["Git/GitHub", "Netlify (deploy, Forms, Blobs)", "QuickBooks API", "ElevenLabs API", "OpenAI API", "i18n/bilingual routing", "ffmpeg media pipelines"],
  },
  {
    label: "Brand & Creative",
    items: ["Visual identity systems", "Typography systems", "Original character/IP design", "Campaign asset production", "Art direction"],
    tools: ["Adobe Photoshop", "Adobe Illustrator", "3D animation"],
  },
  {
    label: "Marketing & Growth",
    items: ["SEO", "GA4 & conversion-event tracking", "JSON-LD structured data", "Social/OG cards", "Lead-generation funnels", "Content-verification governance"],
    tools: ["Google Ads", "Social media strategy"],
  },
  {
    label: "Business & Operations",
    items: ["Team building & leadership (50+ contractors/employees)", "Payroll & workforce operations", "Financial strategy & investor relations", "Nonprofit program direction", "Vendor & scope judgment"],
    tools: [],
  },
];
---
<Layout title="Capabilities" description="Sean Despain's capabilities across product, development, brand, marketing, and business — organized by category, backed by real projects.">
  <Header slot="header" />

  <section class="cap">
    <div class="container cap__inner">
      <p class="eyebrow">Capabilities</p>
      <h1>Organized by what it's for, not by logo count.</h1>
      <p class="cap__intro">
        Every line here traces back to a project on the <a href="/#work">work page</a> — see it applied,
        not just listed.
      </p>

      <div class="cap__groups">
        {groups.map((group) => (
          <div class="cap__group">
            <h2>{group.label}</h2>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            {group.tools.length > 0 && (
              <p class="cap__tools"><span class="eyebrow">Tools</span> {group.tools.join(" · ")}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .cap { padding-block: var(--space-6) var(--space-7); }
  .cap__inner { max-width: 46rem; }
  .cap h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    margin: 0.4rem 0 var(--space-2);
  }
  .cap__intro { color: var(--graphite); margin-bottom: var(--space-5); }
  .cap__intro a { color: var(--ink); }
  .cap__groups { display: flex; flex-direction: column; gap: var(--space-5); }
  .cap__group h2 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    margin: 0 0 var(--space-2);
  }
  .cap__group ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.4rem 1rem;
    padding: 0;
    margin: 0 0 var(--space-2);
    list-style: none;
  }
  .cap__group li {
    padding-left: 1rem;
    position: relative;
  }
  .cap__group li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--graphite);
  }
  .cap__tools { font-size: var(--step--1); color: var(--graphite); }
  .cap__tools .eyebrow { margin-right: 0.4rem; }
</style>
