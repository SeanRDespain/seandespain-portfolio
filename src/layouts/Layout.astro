---
import "../styles/tokens.css";

const {
  title,
  description = "Sean Despain designs, builds, and launches digital products and brands: product, brand, and code from concept through launch.",
  image = "/images/og-default.jpg",
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · Sean Despain` : "Sean Despain · Product Builder & Creative Technologist";
const GA_ID = "G-ZMM05DKGDB";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <slot name="head" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Analytics 4. Every page renders through this layout, and each
         navigation is a full page load (no client-side router), so the
         standard tag records one page_view per page on its own. Only the live
         domain reports: local builds, test runs, and the netlify.app address
         load the tag but send nothing, so they never count as visits. -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      if (!/(^|\.)seandespain\.com$/.test(location.hostname)) window["ga-disable-" + GA_ID] = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag("js", new Date());
      gtag("config", GA_ID);
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Sean Despain",
      url: "https://seandespain.com",
      jobTitle: "Multidisciplinary Product Builder & Creative Technologist",
      email: "mailto:seandespain@gmail.com",
      sameAs: ["https://www.linkedin.com/in/sean-despain-560316116/"],
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      // every public page: remember how this visitor arrived (used only if
      // they send the inquiry form) and report the few actions worth measuring
      import "../scripts/attribution.js";
      import "../scripts/conversion-events.js";
    </script>
  </body>
</html>
